# MongoDB bağlantısı (veritabanı adı: painthouses)
MONGODB_URI=mongodb://USER:PASSWORD@HOST_1:27017,HOST_2:27017,HOST_3:27017/painthouses?ssl=true&replicaSet=REPLICA_SET&authSource=admin
MONGODB_DB=painthouses

# Oturum çerezlerini imzalar. Production'da zorunludur; uzun ve rastgele olmalı:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-this-long-random-secret

# Şifre sıfırlama bağlantılarında kullanılan genel adres (production'da zorunlu)
APP_URL=http://localhost:3000

# Kayıt yetkisi: virgülle ayrılmış yönetici e-postaları. Hiç kullanıcı yokken ilk kayıt
# her zaman serbesttir. Herkesin kayıt olabilmesi için ALLOW_PUBLIC_REGISTRATION=true yapın.
ADMIN_EMAILS=
ALLOW_PUBLIC_REGISTRATION=false

# Şifre sıfırlama e-postalarını gönderen servis
EMAIL_API_URL=http://80.225.238.243:3000/api

# Yüklenebilecek en büyük resim (bayt)
MAX_UPLOAD_BYTES=10485760

# AI maske oluşturma
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5

# Yalnızca `npm run seed` için: ilk yönetici hesabı
ADMIN_EMAIL=
ADMIN_PASSWORD=
